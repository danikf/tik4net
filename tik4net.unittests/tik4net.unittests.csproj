<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      net48 is Windows-only, and has to be. The ubuntu CI job that builds the cross-platform projects
      runs this test project too, and while the SDK will happily COMPILE net48 there against reference
      assemblies, `dotnet test` cannot execute it - which is how the failure presented: a green build
      followed by a test run that died. The netstandard2.0 coverage this leg exists for is worth having,
      but not at the price of the Linux leg that proves the library builds there at all.
    -->
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$(OS)' == 'Windows_NT' ">net8.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>tik4net.unittests</AssemblyName>
    <RootNamespace>tik4net.unittests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    net48 is here to EXECUTE the netstandard2.0 assets. The two shipping libraries multi-target
    netstandard2.0;net8.0, and until this leg existed the netstandard2.0 half was only ever compiled -
    a net8.0 test project resolves the net8.0 asset, so nothing ever ran the other one. net48 is the
    cheapest framework whose nearest asset is netstandard2.0.

    It is expected that a few tests are net8.0-only: the IAsyncEnumerable streaming surface genuinely
    does not exist in the netstandard2.0 build, which is the asymmetry this leg is here to keep honest.
    Exclude such a file below and say why - do not reach for a #if inside the test.
  -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net48' ">
    <!-- ExecuteListWithDurationAsync / ExecuteListUntilDoneAsync are #if NET8_0_OR_GREATER in ApiCommand. -->
    <Compile Remove="Api\ApiAsyncStreamingTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.7.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.7.3" />
    <!--
      Roslyn, for WikiSampleCompilationTests: it compiles the C# blocks out of the wiki and the repository
      README, so a sample that names a member the library does not have fails here instead of in a
      reader's editor. Test-only - nothing shipping references it.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <!-- Workspaces, for the TIK001 code-fix tests (TikFieldObjectEqualityAnalyzerTests): a fix edits a document. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
  </ItemGroup>

  <!--
    The integration suite's test locks and run leases (IntegrationSuite\TestLockTests): they need no router, so
    they are tested here, compiled in from the integration project rather than referencing it (net48, and it
    would drag the whole suite in).
  -->
  <ItemGroup>
    <Compile Include="..\tik4net.integrationtests\TestLocks.cs" Link="IntegrationSuite\Linked\TestLocks.cs" />
    <Compile Include="..\tik4net.integrationtests\RunLease.cs" Link="IntegrationSuite\Linked\RunLease.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\tik4net\tik4net.csproj" />
    <ProjectReference Include="..\tik4net.objects\tik4net.objects.csproj" />
    <!--
      Referenced for the connection-option matrix (TikConnectionSetupOptionMatrixTests): SSH is the one
      transport that lives outside core, and it was the one where hand-copied options rotted unnoticed. It
      is created, never opened, so no SSH server is involved.
    -->
    <ProjectReference Include="..\tik4net.ssh\tik4net.ssh.csproj" />
    <ProjectReference Include="..\tik4net.testing\tik4net.testing.csproj" />
    <!-- The analyzers the tik4net package ships, referenced as a library so their tests can run them. -->
    <ProjectReference Include="..\tik4net.analyzers\tik4net.analyzers.csproj" />
  </ItemGroup>
</Project>
