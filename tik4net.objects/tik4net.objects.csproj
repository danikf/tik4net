<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>tik4net.objects</AssemblyName>
    <RootNamespace>tik4net.Objects</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      Packed as part of the `tik4net` NuGet package produced by tik4net.package.
      Until 4.0 this shipped separately as tik4net.objects, then tik4net.entities.
      Package metadata lives in tik4net.package now.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\tik4net\tik4net.csproj" />
  </ItemGroup>
</Project>
