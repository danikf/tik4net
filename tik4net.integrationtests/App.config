<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="host" value="192.168.4.236"/>
    <add key="user" value="admin"/>
    <add key="pass" value=""/>
    <!-- Deliberately a DIFFERENT port from 'host': the IP path runs over the bridged adapter, the
         MAC-layer path over the second one. MNDP broadcasts do not survive the host's network bridge,
         so the MAC transports only ever see this port; naming the bridged port's MAC here fails all
         six MAC tests with "the router answered nothing". Re-check with mikrotik_discover after any
         change to the VM's adapters -- 'interfaceName' in its answer is the port to name here. -->
    <add key="routerMac" value="00:15:5D:04:1F:01"/>
    <add key="routerIdentity" value="MikroTik"/>
    <!-- Topology assumptions for the high-level test suite (see TestConstants.cs) -->
    <add key="testInterface" value="ether1"/>
    <add key="testWirelessInterface" value="wlan1"/>
    <add key="testAddress" value="192.168.1.1/24"/>
    <add key="catalogDumpDir" value=".\.tik4net"/>
    <!-- Transport selector: Api | ApiSsl | Rest | RestSsl  (overridden by runsettings tik.connectionType) -->
    <add key="connectionType" value="Api"/>
    <!-- REST-specific (optional; defaults: 80 for http, 443 for https) -->
    <add key="restPort" value="80"/>
    <add key="restSslPort" value="443"/>
    <!-- Accept self-signed certificate on REST-SSL -->
    <add key="restAllowInvalidCert" value="true"/>
  </appSettings>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup></configuration>
