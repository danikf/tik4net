<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="host" value="192.168.4.236"/>
    <add key="user" value="admin"/>
    <add key="pass" value=""/>
    <add key="routerMac" value="00:15:5D:04:1F:03"/>
    <add key="routerIdentity" value="CHR"/>
    <!-- CHR2, the second lab router: the RoMON target and the older-RouterOS router (RouterOS 6.49.13, kept
         there on purpose). RomonRelayTest reaches it THROUGH the router above (the agent) and writes
         to it. romonTargetId is its /tool/romon current-id; romonTargetHost is its own IP, used only to check
         independently of the relay what landed there. Leave romonTargetId empty to skip those tests. See
         README.md, "The lab routers". -->
    <add key="romonTargetId" value="00:15:5D:04:1F:0A"/>
    <add key="romonTargetHost" value="192.168.4.237"/>
    <add key="romonTargetUser" value="admin"/>
    <add key="romonTargetPass" value=""/>
    <!-- Router profile "chr2": run the suite against CHR2 itself with TIK4NET_ROUTER=chr2
         (run-integration-tests.ps1 -Router chr2) instead of editing the keys above. A "chr2.<key>" entry overrides
         <key>; a key it does not list keeps the value above (LabConfig.cs). Here CHR2 is the RoMON agent and CHR3
         the target, so RomonRelayTest covers a RouterOS 6 agent and a 7.x target. RouterOS 6 has no REST API: a
         rest/restssl leg against it runs, and every test is Inconclusive on the router's refusal (TestBase,
         Docs/findings-routeros-6.md section 3). -->
    <add key="chr2.host" value="192.168.4.237"/>
    <add key="chr2.user" value="admin"/>
    <add key="chr2.pass" value=""/>
    <add key="chr2.routerMac" value="00:15:5D:04:1F:09"/>
    <add key="chr2.romonTargetId" value="00:15:5D:04:1F:0C"/>
    <add key="chr2.romonTargetHost" value="192.168.4.238"/>
    <add key="chr2.romonTargetUser" value="admin"/>
    <add key="chr2.romonTargetPass" value=""/>
    <!-- Router profile "chr3": a second RouterOS 7 (7.21.5, long-term), run with -Router chr3. No RoMON target: CHR3
         is the target of the chr2 profile, and a relay from it would write to CHR or CHR2 while their legs run. -->
    <add key="chr3.host" value="192.168.4.238"/>
    <add key="chr3.user" value="admin"/>
    <add key="chr3.pass" value=""/>
    <add key="chr3.routerMac" value="00:15:5D:04:1F:0B"/>
    <add key="chr3.romonTargetId" value=""/>
    <!-- Topology assumptions for the high-level test suite (see TestConstants.cs) -->
    <add key="testInterface" value="ether1"/>
    <!-- Pinned: discovery would otherwise take the first ethernet that is not testInterface,
         which on a two-port lab can be the port carrying the connection or the default route. -->
    <add key="testSecondInterface" value="ether2"/>
    <add key="testWirelessInterface" value="wlan1"/>
    <add key="testAddress" value="192.168.1.1/24"/>
    <add key="catalogDumpDir" value=".\.tik4net"/>
    <!-- Transport selector: Api | ApiSsl | Rest | RestSsl  (overridden by runsettings tik.connectionType) -->
    <add key="connectionType" value="Api"/>
    <!-- REST-specific (optional; defaults: 80 for http, 443 for https) -->
    <add key="restPort" value="80"/>
    <add key="restSslPort" value="443"/>
    <!-- Accept self-signed certificate on REST-SSL -->
    <add key="restAllowInvalidCert" value="true"/>
  </appSettings>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup></configuration>
