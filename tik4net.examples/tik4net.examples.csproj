<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      net48 on purpose. This project is the compile-check for the snippets on the wiki, several of which
      use ConfigurationManager/App.config the way the pre-4.0 documentation does; retargeting it would
      quietly change what the snippets are proving. The library itself targets netstandard2.0 and is
      consumable from any modern TFM — tik4net.samples is the demo written the way you would write new
      code today.
    -->
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>tik4net.examples</AssemblyName>
    <RootNamespace>tik4net.examples</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\tik4net\tik4net.csproj" />
    <ProjectReference Include="..\tik4net.objects\tik4net.objects.csproj" />
  </ItemGroup>

</Project>
