<Project>

  <!--
    Shared identity and version for every project in the tree.

    It exists because the version was six copies of the same literal — tik4net, tik4net.objects,
    tik4net.ssh, tik4net.testing, tik4net.package and Tools/tik4net.mcp each declared VersionPrefix,
    AssemblyVersion, FileVersion, the two VersionSuffix rules, Authors and Copyright. A release meant
    editing all six, and nothing failed if one was missed: the build stays green and a single assembly
    ships stamped with the previous version.

    Bump VersionPrefix HERE and nowhere else. A project may still override any of these locally — MSBuild
    takes the last assignment — but should only do so when it genuinely versions independently, and should
    say why where it does it.

    Deliberately NOT here: TargetFramework(s), Nullable and LangVersion. The frameworks differ per project
    on purpose, and a global <Nullable>enable</Nullable> is worse than the duplication it removes — it
    reaches the test, sample and benchmark projects, which were never written nullable-clean, and produces
    513 warnings that CI turns into errors. The four shipping libraries and the MCP tool declare it
    themselves, where it is a statement about that assembly rather than a default nobody chose.
  -->
  <PropertyGroup>
    <VersionPrefix>4.0.0</VersionPrefix>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <VersionSuffix Condition=" '$(BUILD_BUILDNUMBER)' != '' ">CI-$(BUILD_BUILDNUMBER)</VersionSuffix>
    <VersionSuffix Condition=" '$(PREVIEW_NUMBER)' != '' ">pre-$(PREVIEW_NUMBER)</VersionSuffix>
    <Authors>Daniel Frantik</Authors>
    <Copyright>Copyright (C) Daniel Frantik 2026</Copyright>
  </PropertyGroup>

</Project>
