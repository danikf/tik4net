<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>tik4net.ssh</AssemblyName>
    <RootNamespace>tik4net.Ssh</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>tik4net.ssh</PackageId>
    <Description>SSH (TCP 22) connection transport for tik4net — the eleventh connection variant, kept in its own package because of its SSH.NET dependency. Drives the MikroTik RouterOS CLI over an SSH PTY shell with the same connection contract and the same three API levels as every other transport: full CRUD, Listen and Safe Mode. Requires the tik4net package.</Description>
    <PackageTags>Mikrotik Library API CSharp .NET Manage SSH</PackageTags>
    <PackageProjectUrl>https://github.com/danikf/tik4net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/danikf/tik4net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>../Build</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../LICENSE" Pack="true" PackagePath="\" />
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <!--
    Split reference, on purpose:
      * tik4net.csproj  — compile assets only. PrivateAssets="all" keeps its internal
        PackageId (tik4net.core.internal) out of this package's dependencies.
      * tik4net.package — no compile assets, but contributes the real `tik4net`
        dependency to the generated .nuspec.
    Referencing only the first one would emit a dependency on a package that does not
    exist on nuget.org.
  -->
  <ItemGroup>
    <ProjectReference Include="..\tik4net\tik4net.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\tik4net.package\tik4net.package.csproj" />
  </ItemGroup>
</Project>
