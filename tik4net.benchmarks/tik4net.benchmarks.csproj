<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>tik4net.benchmarks</AssemblyName>
    <RootNamespace>tik4net.Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet refuses to run a DEBUG build; Release is what CI and a manual run both use. -->
    <Optimize Condition=" '$(Configuration)' == 'Release' ">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\tik4net\tik4net.csproj" />
    <ProjectReference Include="..\tik4net.objects\tik4net.objects.csproj" />
    <ProjectReference Include="..\tik4net.testing\tik4net.testing.csproj" />
  </ItemGroup>
</Project>
