<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Packaging-only project. Produces the `tik4net` NuGet package containing BOTH
    tik4net.dll (core) and tik4net.objects.dll (O/R mapper).

    It compiles nothing of its own — IncludeBuildOutput=false drops its own (empty)
    assembly, and the AddReferencedAssembliesToPackage target below copies the two
    referenced assemblies + their XML docs into lib/<tfm>/.

    Rationale: until 4.0 the O/R mapper shipped as its own package (tik4net.objects, then
    tik4net.entities); consumers had to reference both and keep the versions in step. One
    package with both assemblies removes that failure mode.
  -->

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <PackageId>tik4net</PackageId>
    <Description>Manage MikroTik RouterOS devices from .NET. Includes both the low-level ADO.NET-like API and the high-level O/R mapper with 169 ready-made entities, over 11 transports: binary API, API-SSL, REST, Telnet, SSH, MAC-Telnet and WinBox (CLI and native-M2, over IP or MAC layer). The O/R mapper was previously distributed separately as tik4net.objects / tik4net.entities; since 4.0 it is part of this package.</Description>
    <PackageTags>Mikrotik RouterOS Library API CSharp .NET Manage ORM Entities WinBox MacTelnet</PackageTags>
    <PackageProjectUrl>https://github.com/danikf/tik4net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/danikf/tik4net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>../Build</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../LICENSE" Pack="true" PackagePath="\" />
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    PrivateAssets="all" stops NuGet from emitting these as package *dependencies*
    (they are not published separately any more). The consequence is that their own
    PackageReferences do not flow either, so real dependencies must be repeated below.
  -->
  <ItemGroup>
    <ProjectReference Include="..\tik4net\tik4net.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\tik4net.objects\tik4net.objects.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Must mirror the PackageReferences of the projects packed above. -->
  <ItemGroup>
    <!-- netstandard2.0 only: net8.0 has System.Text.Json in its shared framework, and a package
         reference there would pin consumers to a version for no reason. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

  <Target Name="AddReferencedAssembliesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_PackedAssembly Include="@(ReferencePath)"
                       Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'" />
      <TfmSpecificPackageFile Include="@(_PackedAssembly)"
                              PackagePath="lib/$(TargetFramework)/" />
      <TfmSpecificPackageFile Include="@(_PackedAssembly->'%(RootDir)%(Directory)%(Filename).xml')"
                              PackagePath="lib/$(TargetFramework)/"
                              Condition="Exists('%(RootDir)%(Directory)%(Filename).xml')" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);AddReferencedAssembliesToPackage
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

</Project>
